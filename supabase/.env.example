# ======================================================================
# FARHA SUPABASE — FICHIER .env (Edge Functions secrets)
# ======================================================================
# NE JAMAIS commiter le fichier .env réel — seul ce .env.example doit
# être versionné dans Git.
#
# À utiliser ainsi :
#   1. Copiez ce fichier vers supabase/.env (avec les vraies valeurs)
#   2. Lancez: supabase secrets set --env-file supabase/.env
#
# Les secrets seront alors disponibles via Deno.env.get() dans les
# Edge Functions, et automatiquement injectés en production.
# ======================================================================

# ─────────────────────────────────────────────────────────────────
# SUPABASE (fournis automatiquement en production, nécessaires en dev)
# ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─────────────────────────────────────────────────────────────────
# SITE
# ─────────────────────────────────────────────────────────────────
# URL du site en production (utilisée dans les redirections de paiement)
# Ex: https://app.farha.com
SITE_URL=https://votre-domaine.com

# ─────────────────────────────────────────────────────────────────
# GEMINI (génération de paroles)
# ─────────────────────────────────────────────────────────────────
# Clé API Google Gemini (obtenue sur https://ai.google.dev)
# Projet → Credentials → Create API Key
GEMINI_API_KEY=AIzaSy...

# ─────────────────────────────────────────────────────────────────
# MOTEUR MUSICAL (choix par défaut)
# ─────────────────────────────────────────────────────────────────
# "suno" ou "lyria" — voir rapport de recherche du 08/08/2026
# Tant que Suno n'a pas d'API self-service, laisser "lyria" par défaut
MUSIC_PROVIDER_DEFAULT=lyria

# ─────────────────────────────────────────────────────────────────
# GARDE-FOU DE MARGE (generate-music)
# ─────────────────────────────────────────────────────────────────
# Nombre de compositions gratuites (audio + pochette, ~0,12-0,22$ de coût
# API réel par composition) autorisées par utilisateur sur 24h glissantes.
# Sans limite, un compte peut créer un nombre illimité de chansons gratuites
# qui ne convertissent jamais en achat — voir README §7 "Marge".
FREE_GENERATIONS_PER_DAY=1

# ─────────────────────────────────────────────────────────────────
# SUNO (si accès partenaire obtenu)
# ─────────────────────────────────────────────────────────────────
# IMPORTANT : Suno n'a PAS d'API self-service publique.
# Ne remplir ces champs que si vous avez un accès partenaire officiel.
# NE JAMAIS utiliser un wrapper tiers (SunoAPI.org, etc) en production.
SUNO_API_KEY=
SUNO_API_BASE_URL=

# ─────────────────────────────────────────────────────────────────
# GOOGLE LYRIA (génération musicale via Vertex AI)
# ─────────────────────────────────────────────────────────────────
# ID du projet GCP
GCP_PROJECT_ID=votre-projet-gcp

# Région GCP (ex: us-central1, europe-west1)
GCP_LOCATION=us-central1

# Modèle Vertex AI à utiliser (ex: lyria-3-pro)
LYRIA_MODEL=lyria-3-pro

# Token d'accès Vertex AI — EN DEV SEULEMENT
# En production, utiliser Workload Identity ou un compte de service OAuth2 signé
VERTEX_ACCESS_TOKEN=ya29...

# ─────────────────────────────────────────────────────────────────
# STRIPE (paiement)
# ─────────────────────────────────────────────────────────────────
# Clé secrète Stripe (sk_live_... ou sk_test_...)
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Secret de signature webhook Stripe
# https://dashboard.stripe.com/webhooks → créer endpoint
STRIPE_WEBHOOK_SECRET=whsec_...

# ─────────────────────────────────────────────────────────────────
# PAYPAL (paiement)
# ─────────────────────────────────────────────────────────────────
# Client ID PayPal (https://developer.paypal.com/dashboard/apps/sandbox)
PAYPAL_CLIENT_ID=AY...

# Client Secret PayPal
PAYPAL_CLIENT_SECRET=...

# Webhook ID PayPal (créé dans le dashboard, onglet Webhooks)
PAYPAL_WEBHOOK_ID=...

# Environnement : "sandbox" ou "live"
PAYPAL_ENV=sandbox

# ─────────────────────────────────────────────────────────────────
# FEDAPAY (paiement Afrique/Maghreb)
# ─────────────────────────────────────────────────────────────────
# Clé secrète Fedapay (https://sandbox.fedapay.com/dashboard)
FEDAPAY_SECRET_KEY=sk_sandbox_...

# Secret partagé pour signature des webhooks Fedapay
FEDAPAY_WEBHOOK_SECRET=...

# Environnement : "sandbox" ou "live"
FEDAPAY_ENV=sandbox

# ─────────────────────────────────────────────────────────────────
# BREVO (e-mails transactionnels)
# ─────────────────────────────────────────────────────────────────
# Clé API Brevo (https://app.brevo.com/settings/account/api)
BREVO_API_KEY=xkeysib-...

# Adresse e-mail d'envoi (ex: bienvenue@farha.com)
BREVO_SENDER_EMAIL=bienvenue@farha.com

# ID de template Brevo (optionnel)
# Si laissé vide, un e-mail HTML inline est utilisé
# Si rempli, doit correspondre à un template créé dans Brevo
BREVO_WELCOME_TEMPLATE_ID=

# ─────────────────────────────────────────────────────────────────
# SÉCURITÉ INTERNE
# ─────────────────────────────────────────────────────────────────
# Secret partagé pour authentifier les appels internes entre Edge Functions
# À générer avec une vraie valeur aléatoire en production
INTERNAL_SECRET=your-secret-key-change-this-in-production
